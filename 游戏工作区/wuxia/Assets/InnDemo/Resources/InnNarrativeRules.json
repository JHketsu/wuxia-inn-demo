  "dialogueVariants": [
    {
      "id": "sword_known_force",
      "group": "afterSword",
      "all": [
        "pactAgreed",
        "swordS3"
      ],
      "text": "她看着你从老板手中拿走剑，沉默片刻。\n「这把剑是怎么来的，我看见了。但我们说定的路，我没忘。」"
    },
    {
      "id": "sword_known",
      "group": "afterSword",
      "all": [
        "pactAgreed"
      ],
      "text": "你接稳了剑。她整理好衣袖，朝门口看了一眼。\n「照刚才说好的走。我跟着你。」"
    },
    {
      "id": "sword_unknown_force",
      "group": "afterSword",
      "all": [
        "swordS3"
      ],
      "text": "她看着你把剑收起。\n「我会跟你走。不过出了门以后，有些话我们得先说清楚。」"
    },
    {
      "id": "sword_unknown",
      "group": "afterSword",
      "all": [],
      "text": "老板把剑交给你。她看着你接稳，轻轻开口。\n「出了客栈以后，你打算怎么走？」"
    },
    {
      "id": "pact_existing",
      "group": "pactGreeting",
      "all": [
        "pactAgreed"
      ],
      "text": "「我们已经说定了。你是想再确认一句，还是有什么变了？」"
    },
    {
      "id": "pact_new",
      "group": "pactGreeting",
      "all": [],
      "text": "她扶着桌沿站稳，看向门外，又转过头等你开口。"
    }
  ],
